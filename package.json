{
    "name": "react-canvas-ai-monorepo",
    "private": true,
    "type": "module",
    "description": "Monorepo root for react-canvas-ai, a general-purpose mask editor for React image manipulation apps.",
    "license": "Apache-2.0",
    "author": "Vinicius Egidio <me@vinicius.io> (https://vinicius.io)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vegidio/react-canvas-ai.git"
    },
    "homepage": "https://github.com/vegidio/react-canvas-ai#readme",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "pnpm --filter react-canvas-ai dev",
        "dev:playground": "pnpm --parallel --filter react-canvas-ai --filter playground dev",
        "build": "pnpm --filter react-canvas-ai build",
        "build:all": "pnpm -r build",
        "test": "pnpm -r test",
        "test:coverage": "pnpm -r test:coverage",
        "typecheck": "pnpm -r typecheck",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && pnpm build && pnpm typecheck && pnpm test",
        "fix": "biome check --write .",
        "version:set": "node scripts/set-version.mjs",
        "prepare": "simple-git-hooks"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "lint-staged": "^17.3.0",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^7.0.2"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm exec lint-staged"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,md}": "biome check --write --no-errors-on-unmatched"
    }
}
